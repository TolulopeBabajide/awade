# Production Environment Configuration

# Database Configuration (Render will provide this)
DATABASE_URL=postgresql://awade_user:password@host:5432/awade

# Security Keys (Render will generate these)
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# AI Service Configuration
# Provider selector — openai | gemini | mock (read by packages/ai/gpt_service.py)
AI_PROVIDER=openai

# OpenAI (active when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/openai_provider.py
OPENAI_MODEL_BASIC=gpt-4o-mini   # read by packages/ai/providers/openai_provider.py (light/fast tasks)
OPENAI_MODEL_STANDARD=gpt-4o     # read by packages/ai/providers/openai_provider.py (complex tasks)

# Gemini (active when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_BASIC=gemini-flash-latest    # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_STANDARD=gemini-flash-latest # read by packages/ai/providers/gemini_provider.py

# Shared AI settings
AI_MAX_TOKENS=4000         # read by packages/ai/gpt_service.py (AWD-M-149: was OPENAI_MAX_TOKENS which the app never reads)
AI_TEMPERATURE=0.7         # read by packages/ai/gpt_service.py (AWD-M-154: was OPENAI_TEMPERATURE which the app never reads)

# Optional: Redis content cache (packages/ai/cache.py; omit REDIS_HOST/PORT to disable)
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Must be exactly "production" in production.
# The dev-secret JWT fallback is only allowed for: development, test, testing.
# Any other value (including "staging") requires JWT_SECRET_KEY to be set (AWD-M-142).
ENVIRONMENT=production

# CORS Configuration (Update with your Vercel domain)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Trusted Hosts (AWD-L-04) — restrict Host header to your production domains
ALLOWED_HOSTS=awade.app,www.awade.app

# Password Security
PASSWORD_MIN_LENGTH=8
# bcrypt 4.3.0 enforces a hard 72-byte UTF-8 input limit (truncate_error=True).
# Do not set this above 72 — passwords > 72 bytes will crash hashpw() with HTTP 500.
PASSWORD_MAX_LENGTH=72
JWT_EXPIRES_MINUTES=60

# Optional: Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Optional: Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@awade.com

# Observability — Sentry (AWD-H-01)
# Set this to your Sentry project DSN in production.
SENTRY_DSN=your-sentry-dsn-here
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=your-frontend-sentry-dsn-here

# Frontend — API base URL (read by apps/frontend/src/services/api.ts)
# REQUIRED in production — the URL of your deployed backend.
VITE_API_URL=https://your-api-domain.com

# Frontend — WebSocket URL (AWD-M-52)
# REQUIRED in production — the URL of your deployed backend WebSocket endpoint.
# Must match the domain in ALLOWED_ORIGINS above.
# Example: VITE_WS_URL=wss://api.awade.app/ws
VITE_WS_URL=wss://your-api-domain.com/ws
