# Awade Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/awade_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_MINUTES=60

# Password Security
PASSWORD_MIN_LENGTH=8
# bcrypt 4.3.0 enforces a hard 72-byte UTF-8 input limit (truncate_error=True).
# Do not set this above 72 — passwords > 72 bytes will crash hashpw() with HTTP 500.
PASSWORD_MAX_LENGTH=72

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Test User Configuration (for development only)
ADMIN_EMAIL=admin@awade.com
ADMIN_PASSWORD=admin123
EDUCATOR_EMAIL=educator@awade.com
EDUCATOR_PASSWORD=educator123

# AI Service Configuration
# Provider selector — openai | gemini | mock (read by packages/ai/gpt_service.py)
AI_PROVIDER=openai

# OpenAI (active when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/openai_provider.py
OPENAI_MODEL_BASIC=gpt-4o-mini   # read by packages/ai/providers/openai_provider.py (light/fast tasks)
OPENAI_MODEL_STANDARD=gpt-4o     # read by packages/ai/providers/openai_provider.py (complex tasks)

# Gemini (active when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_BASIC=gemini-flash-latest    # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_STANDARD=gemini-flash-latest # read by packages/ai/providers/gemini_provider.py

# Shared AI settings
AI_MAX_TOKENS=4000         # read by packages/ai/gpt_service.py (AWD-M-149: was OPENAI_MAX_TOKENS which the app never reads)
AI_TEMPERATURE=0.7         # read by packages/ai/gpt_service.py (AWD-M-154: was OPENAI_TEMPERATURE which the app never reads)

# Optional: Redis content cache (packages/ai/cache.py connects to REDIS_HOST:REDIS_PORT; omit to disable)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
# Valid values: development | test | testing | production
# Any other value (e.g. "staging") will cause the server to refuse startup
# if JWT_SECRET_KEY is not set — the dev-secret fallback is only allowed in
# development, test, and testing environments (AWD-M-142).
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@awade.com

# Observability — Sentry (AWD-H-01)
# Leave blank to disable error monitoring (safe for local dev / test).
SENTRY_DSN=
# Fraction of transactions sampled for performance monitoring (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend: set in apps/frontend/.env
# VITE_SENTRY_DSN=

# Frontend — API base URL (read by apps/frontend/src/services/api.ts)
# Leave unset for local development (defaults to relative /api path).
# In production, set to your deployed backend URL.
# VITE_API_URL=https://api.awade.app

# Frontend — WebSocket URL (AWD-M-52)
# URL the browser connects to for real-time AI generation progress.
# Leave as ws://localhost:8000/ws for local development.
# In production, set to your deployed backend WebSocket endpoint.
VITE_WS_URL=ws://localhost:8000/ws