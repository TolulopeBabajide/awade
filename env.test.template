# Test Environment Configuration
# Copy this to .env.test and fill in your actual values

# Database Configuration (Render Test Database)
DATABASE_URL=postgresql://awade_test_user:password@host:5432/awade_test

# Security Keys (Use different keys for test environment)
JWT_SECRET_KEY=your-test-jwt-secret-key-change-this

# AI Service Configuration (use "mock" to avoid real API calls in tests)
AI_PROVIDER=mock             # openai | gemini | mock; use mock to prevent live LLM calls in CI

# OpenAI (only needed if AI_PROVIDER=openai in test runs)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/openai_provider.py
OPENAI_MODEL_BASIC=gpt-4o-mini   # read by packages/ai/providers/openai_provider.py
OPENAI_MODEL_STANDARD=gpt-4o     # read by packages/ai/providers/openai_provider.py

# Gemini (only needed if AI_PROVIDER=gemini in test runs)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TIMEOUT_SECONDS=60        # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_BASIC=gemini-flash-latest    # read by packages/ai/providers/gemini_provider.py
GEMINI_MODEL_STANDARD=gemini-flash-latest # read by packages/ai/providers/gemini_provider.py

# Shared AI settings
AI_MAX_TOKENS=4000         # read by packages/ai/gpt_service.py (AWD-M-149: was OPENAI_MAX_TOKENS which the app never reads)
AI_TEMPERATURE=0.7         # read by packages/ai/gpt_service.py (AWD-M-154: was OPENAI_TEMPERATURE which the app never reads)

# Optional: Redis content cache (omit to disable in test env)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=testing

# CORS Configuration (Test domains)
ALLOWED_ORIGINS=https://awade-test.vercel.app,http://localhost:3000,http://localhost:5173

# Trusted Hosts (AWD-L-04) — testserver is the FastAPI TestClient's default Host
ALLOWED_HOSTS=*

# Password Security
PASSWORD_MIN_LENGTH=8
# bcrypt 4.3.0 enforces a hard 72-byte UTF-8 input limit (truncate_error=True).
# Do not set this above 72 — passwords > 72 bytes will crash hashpw() with HTTP 500.
PASSWORD_MAX_LENGTH=72
JWT_EXPIRES_MINUTES=60

# Test User Configuration
ADMIN_EMAIL=admin-test@awade.com
ADMIN_PASSWORD=admin123
EDUCATOR_EMAIL=educator-test@awade.com
EDUCATOR_PASSWORD=educator123

# Optional: Google OAuth (Test Client ID)
GOOGLE_CLIENT_ID=your-test-google-oauth-client-id

# Optional: Email Configuration (Test SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-test-email@gmail.com
SMTP_PASSWORD=your-test-app-password
EMAIL_FROM=test@awade.com

# Observability — Sentry (AWD-H-01)
# Intentionally blank — Sentry is disabled when ENVIRONMENT=testing.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=

# Frontend — WebSocket URL (AWD-M-52)
# Connect to local dev backend during test runs.
VITE_WS_URL=ws://localhost:8000/ws
