# Awade Environment Configuration

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/awade
# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

->

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# User Management (Required for database initialization)
ADMIN_EMAIL=admin@awade.org
ADMIN_PASSWORD=your_secure_admin_password_here
EDUCATOR_EMAIL=grace.teacher@school.com
EDUCATOR_PASSWORD=your_secure_educator_password_here
# API Keys
AI_PROVIDER=gemini # openai or gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL_BASIC=gemini-flash-latest
GEMINI_MODEL_STANDARD=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# External Services
REDIS_URL=redis://localhost:6379
EMAIL_SERVICE=your_email_service_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/awade.log

# Trusted Hosts (AWD-L-04)
# Comma-separated list of allowed Host header values.
# Leave as "*" (or unset) for local development — allows any host.
# In production set to your actual domain(s): awade.app,www.awade.app
ALLOWED_HOSTS=*

# Observability — Sentry (AWD-H-01)
# Leave blank to disable error monitoring (safe for local dev / test).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend Sentry DSN (set in apps/frontend/.env as VITE_SENTRY_DSN)
VITE_SENTRY_DSN=

# Frontend — WebSocket URL (AWD-M-52)
# URL the browser connects to for real-time AI generation progress.
# Leave as ws://localhost:8000/ws for local development.
# In production, set to your deployed backend WebSocket endpoint:
#   e.g. VITE_WS_URL=wss://api.awade.app/ws
VITE_WS_URL=ws://localhost:8000/ws
